{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/schemas/v0.1/genome.schema.json",
  "title": "Agenomic Genome",
  "type": "object",
  "required": ["spec_version", "agent", "runtime", "tools", "skills", "knowledge", "policies"],
  "properties": {
    "spec_version": { "type": "string", "enum": ["0.1", "0.2"] },
    "agent": {
      "type": "object",
      "required": ["id", "name", "domain", "criticality"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["model_provider", "model_id"],
      "properties": {
        "model_provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_fingerprint": { "type": "string" },
        "temperature": { "type": "number" }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string" },
          "server": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "snapshot_hash": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "stores_user_specific_data": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "description": "Portable execution contract consumed by agenomic-os to run this agent from an agent:// reference. Optional; introduced in spec 0.2.",
      "required": ["entrypoint", "runtime"],
      "properties": {
        "entrypoint": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["command"],
              "description": "MVP supports `command` only. Future kinds (docker, wasm) are reserved."
            },
            "command": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "runtime": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["python", "node", "rust", "binary"]
            },
            "version": {
              "type": "string",
              "description": "Optional semver range, e.g. \">=3.11,<3.13\"."
            }
          },
          "additionalProperties": true
        },
        "working_directory": {
          "type": "string",
          "description": "Relative to bundle root. Defaults to \".\" when omitted."
        },
        "env": {
          "type": "object",
          "description": "Declared environment variables. Variables NOT listed here are NOT propagated from the parent process to the agent.",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "optional": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "description": "Capability declarations enforced by agenomic-os before launch. Empty/missing = denied.",
          "properties": {
            "filesystem": {
              "type": "object",
              "properties": {
                "read": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "write": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            },
            "network": {
              "type": "object",
              "properties": {
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Host or CIDR. Empty = no network access."
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
