{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlock.dev/schemas/v0.1/genome.schema.json",
  "title": "AgentLock Genome",
  "type": "object",
  "required": ["spec_version", "agent", "runtime", "tools", "skills", "knowledge", "policies"],
  "properties": {
    "spec_version": { "type": "string", "enum": ["0.1"] },
    "agent": {
      "type": "object",
      "required": ["id", "name", "domain", "criticality"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["model_provider", "model_id"],
      "properties": {
        "model_provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_fingerprint": { "type": "string" },
        "temperature": { "type": "number" }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string" },
          "server": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "snapshot_hash": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "stores_user_specific_data": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
