{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/schemas/v0.2/workflow.schema.json",
  "title": "Agenomic Workflow",
  "description": "Declarative workflow: an ordered, possibly branching, possibly long-running composition of agent calls, tool steps, human gates, signal waits, loops, and sub-workflows. Introduced in spec 0.2 (RFC 0009).",
  "type": "object",
  "required": ["spec_version", "workflow", "steps"],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["0.2", "agenomic/v0.2"]
    },
    "workflow": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string" },
        "criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "standard",
            "sensitive",
            "regulated_customer_facing",
            "life_critical"
          ]
        },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "description": "Non-normative hint about the runtime executing this workflow (e.g. temporal, langgraph, crewai, custom). Tooling MUST NOT require it.",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["api", "event", "schedule", "signal", "manual"]
          },
          "description": { "type": "string" },
          "event": { "type": "string" },
          "schedule": { "type": "string" },
          "signal": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "inputs": { "$ref": "#/$defs/io_fields" },
    "outputs": { "$ref": "#/$defs/io_fields" },
    "state": {
      "type": "object",
      "description": "Reference to the shared context schema. Schema only; runtime state is never bundled.",
      "properties": {
        "schema_path": { "type": "string" },
        "schema_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "signals": { "$ref": "#/$defs/signals" },
    "escalation_rules": { "$ref": "#/$defs/escalation_rules" },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "io_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "payload_schema_path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "route"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["agent", "tool", "human", "wait", "workflow", "loop"]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "agent": { "type": "string", "minLength": 1 },
        "skill": { "type": "string" },
        "tool": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "protocol": { "type": "string" },
            "server": { "type": "string" },
            "version": { "type": "string" }
          },
          "additionalProperties": true
        },
        "gate": {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "action": {
              "type": "string",
              "enum": ["approve", "review", "input", "decide"]
            },
            "sla": { "$ref": "#/$defs/duration" },
            "on_timeout": {
              "type": "string",
              "enum": ["escalate", "fail", "continue"]
            },
            "escalation_route": { "type": "string" }
          },
          "additionalProperties": true
        },
        "wait_for": {
          "type": "object",
          "required": ["signals"],
          "properties": {
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "mode": { "type": "string", "enum": ["any", "all"] },
            "timeout": { "$ref": "#/$defs/duration" },
            "on_timeout": {
              "type": "string",
              "enum": ["escalate", "fail", "continue"]
            }
          },
          "additionalProperties": true
        },
        "uses": { "type": "string", "minLength": 1 },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "until": { "type": "string" },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "when": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "retry": {
          "type": "object",
          "required": ["max_attempts"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1 },
            "backoff": {
              "type": "string",
              "enum": ["none", "fixed", "exponential"]
            },
            "initial_interval": { "$ref": "#/$defs/duration" }
          },
          "additionalProperties": true
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "on_error": {
          "type": "string",
          "enum": ["fail", "continue", "escalate"]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "agent" } } },
          "then": { "required": ["agent"] }
        },
        {
          "if": { "properties": { "type": { "const": "tool" } } },
          "then": { "required": ["tool"] }
        },
        {
          "if": { "properties": { "type": { "const": "human" } } },
          "then": { "required": ["gate"] }
        },
        {
          "if": { "properties": { "type": { "const": "wait" } } },
          "then": { "required": ["wait_for"] }
        },
        {
          "if": { "properties": { "type": { "const": "workflow" } } },
          "then": { "required": ["uses"] }
        },
        {
          "if": { "properties": { "type": { "const": "loop" } } },
          "then": { "required": ["body", "until"] }
        }
      ]
    }
  }
}
