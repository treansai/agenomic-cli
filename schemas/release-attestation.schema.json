{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlock.dev/schemas/v0.1/release-attestation.schema.json",
  "title": "AgentLock Release Attestation",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_type",
    "agent_id",
    "bundle_logical_hash",
    "bundle_archive_hash",
    "generated_at",
    "generator"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "attestation_type": { "type": "string", "enum": ["release"] },
    "agent_id": { "type": "string", "minLength": 1 },
    "bundle_logical_hash": { "type": "string", "minLength": 1 },
    "bundle_archive_hash": { "type": "string", "minLength": 1 },
    "replay_report_hash": { "type": "string" },
    "atep_root_hash": { "type": "string" },
    "contract_passed": { "type": "boolean" },
    "generated_at": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "signature": {
      "type": ["object", "null"],
      "required": ["algorithm", "key_id", "public_key_pem", "signature"],
      "properties": {
        "algorithm": { "type": "string" },
        "key_id": { "type": "string" },
        "public_key_pem": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
