{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlock.dev/schemas/v0.1/trace-event.schema.json",
  "title": "AgentLock Trace Envelope",
  "type": "object",
  "required": ["trace_id", "agent_id", "input"],
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "arguments": { "type": "object" },
          "result": {},
          "human_approval_present": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
