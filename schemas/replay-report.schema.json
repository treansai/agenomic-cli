{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/schemas/v0.1/replay-report.schema.json",
  "title": "Agenomic Replay Report",
  "type": "object",
  "required": [
    "report_version",
    "bundle_hash",
    "contract_id",
    "total_traces",
    "contract_passed"
  ],
  "properties": {
    "report_version": { "type": "string" },
    "bundle_hash": { "type": "string", "minLength": 1 },
    "bundle_logical_hash": { "type": "string" },
    "contract_id": { "type": "string", "minLength": 1 },
    "total_traces": { "type": "integer", "minimum": 0 },
    "total_runs": { "type": "integer", "minimum": 0 },
    "mode": { "type": "string" },
    "contract_passed": { "type": "boolean" },
    "violations": { "type": "array" },
    "aggregates": { "type": "object" },
    "generated_at": { "type": "string" }
  },
  "additionalProperties": true
}
