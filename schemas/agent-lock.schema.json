{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentLock Bundle Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "behavior_contract_id", "tracked_files"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "behavior_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "tracked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "blake3": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
