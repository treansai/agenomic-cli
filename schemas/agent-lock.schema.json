{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/schemas/v0.1/agent-lock.schema.json",
  "title": "Agenomic Lockfile",
  "type": "object",
  "required": ["spec_version", "agent_id", "model", "tools", "knowledge"],
  "properties": {
    "spec_version": { "type": "string", "enum": ["0.1", "0.2"] },
    "agent_id": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["provider", "model_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string" },
        "temperature": { "type": "number" },
        "revision": {
          "type": "string",
          "description": "Requested model revision (branch/tag/commit), e.g. 'main'."
        },
        "resolved_commit": {
          "type": "string",
          "description": "Resolved commit SHA (or equivalent revision identifier) captured at lock time. Makes the release reproducible."
        },
        "task": {
          "type": "string",
          "description": "Provider task/pipeline tag, e.g. text-generation."
        },
        "endpoint_ref": {
          "type": "string",
          "description": "Redacted reference to a configured inference endpoint (scheme://host[/path]); never the full URL or any credentials."
        },
        "endpoint_hash": {
          "type": "string",
          "description": "BLAKE3 hash of the configured endpoint URL, for drift detection without storing the URL verbatim."
        },
        "metadata_hash": {
          "type": "string",
          "description": "BLAKE3 hash of the resolved model metadata (model_id, revision, resolved_commit, task)."
        },
        "parameter_hash": {
          "type": "string",
          "description": "BLAKE3 hash of the canonicalized model parameters."
        }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "protocol"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "minLength": 1 },
          "server": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "snapshot_hash"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "snapshot_hash": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "execution_hash": {
      "type": "string",
      "description": "BLAKE3 hash of the canonicalized `execution` block from genome.yaml. Used by agenomic-os to detect execution-contract drift between bundle build time and run time. Optional; introduced in spec 0.2.",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
