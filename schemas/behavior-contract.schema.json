{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlock.dev/schemas/v0.1/behavior-contract.schema.json",
  "title": "AgentLock Behavior Contract",
  "type": "object",
  "required": ["spec_version", "contract"],
  "properties": {
    "spec_version": { "type": "string", "enum": ["0.1"] },
    "contract": {
      "type": "object",
      "required": ["id", "rules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "severity"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "severity": {
                "type": "string",
                "enum": ["info", "low", "medium", "high", "critical"]
              },
              "description": { "type": "string" },
              "required_fields": {
                "type": "array",
                "items": { "type": "string" }
              },
              "forbidden_tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sensitive_tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "output_format": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
