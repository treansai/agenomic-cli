{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentLock Behavior Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "require_final_output" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "tools"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "required_tool_calls" },
                  "tools": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "min_calls": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "tools"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "forbidden_tool_calls" },
                  "tools": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "values"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "required_output_contains_all" },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "values"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "forbidden_output_contains_any" },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "max"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "max_tool_calls" },
                  "max": { "type": "integer", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "max"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "type": { "const": "max_total_events" },
                  "max": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
