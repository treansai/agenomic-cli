# Copy to `.env` and fill in. Never commit real secrets.

# --- `agm enrich` provider selection ----------------------------------------
# Default provider when neither --provider nor --cloud is passed.
# One of: direct | cloud
AGENOMIC_ENRICH_PROVIDER=direct

# --- direct provider (default) ----------------------------------------------
# The genome's runtime.model_provider decides which key is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- cloud provider (`agm enrich --cloud`) ----------------------------------
# Routes through Agenomic Cloud: it authenticates you with your Agenomic API
# key and reaches the internal model server-side, so NO model/Scaleway secret
# lives on the client. Authenticate once with:
#     agm cloud login --api-key <YOUR_AGENOMIC_API_KEY>
# (credentials are stored in ~/.config/agenomic, not in this file).
