# Copy to `.env` and fill in. Never commit real secrets.

# --- `agm enrich` provider selection ----------------------------------------
# Default provider when neither --provider nor --cloud is passed.
# One of: direct | cloud
AGENOMIC_ENRICH_PROVIDER=direct

# --- direct provider (default) ----------------------------------------------
# The genome's runtime.model_provider decides which key is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- cloud provider (`agm enrich --cloud`) ----------------------------------
# Internal OpenAI-compatible LLM hosted on our cloud (Scaleway).
# Endpoint is configurable so it can also target a dedicated Managed Inference
# deployment, e.g. https://<UUID>.ifr.fr-par.scaleway.com/v1
AGENOMIC_CLOUD_BASE_URL=https://api.scaleway.ai/v1
# Scaleway secret key (SCW_SECRET_KEY), sent as a Bearer token. Required in
# cloud mode; never falls back to ANTHROPIC_API_KEY/OPENAI_API_KEY.
AGENOMIC_CLOUD_API_KEY=
AGENOMIC_CLOUD_MODEL=llama-3.3-70b-instruct
