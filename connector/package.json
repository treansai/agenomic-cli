{
  "name": "@agenomic/coding-connector",
  "version": "0.1.0",
  "description": "Agenomic machine connector: enrolls a machine, supervises Claude Code and Codex sessions and connects their native control points to Agenomic.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "agenomic-connector": "bin/agenomic-connector.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --test test/unit.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289"
  },
  "optionalDependencies": {
    "@openai/codex": "0.160.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.3"
  }
}
